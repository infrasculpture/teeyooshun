# Copy to .env on the server and fill in. Never commit .env.

# Host port the app is served on (LAN: http://<server-ip>:PORT/)
PORT=3002

# Host folder mounted into the container at /app/data (database, scans, extracted content)
DATA_DIR=./data

# Sensitive Info
ANTHROPIC_API_KEY=replace-me
PARENT_PIN=0000

# Marking (spec section 7)
# MARKING_MODEL=claude-opus-5-5
MARKING_MODEL=claude-sonnet-5-5
# LIGHT_MODEL=claude-sonnet-5-5
LIGHT_MODEL=claude-haiku-4-5-20251001
MARKING_EFFORT=medium

# Parent dashboard, Cost section. Set the real values in the server's .env.
# Fixed conversion rate: how many Singapore dollars one US dollar is worth
USD_SGD_RATE=1.35
# Monthly subscription (SG$) that counts against the budget; 0 if none
SUBSCRIPTION_SGD=0
# Total monthly budget (SG$) including the subscription. The dashboard turns amber at 80% and red at 100%.
MONTHLY_BUDGET_SGD=100

# Retry on Anthropic's fallback model if the main model declines (true/false)
REFUSAL_FALLBACK=true

# Database inside the container (use a different file for development)
DB_PATH=/app/data/teeyooshun.db

# Ingestion (scanned PDFs). Blank INGEST_MODEL = the marking model.
INGEST_MODEL=
# Blank = the marking effort; "none" = don't send effort (needed for a Haiku ingest model)
INGEST_EFFORT=
# Long edge of page renders sent to the model, in pixels
INGEST_MAX_EDGE=1568