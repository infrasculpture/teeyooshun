# Copy to .env on the server and fill in. Never commit .env.

# Host port the app is served on (LAN: http://<server-ip>:PORT/)
PORT=3002

# Host folder mounted into the container at /app/data (database, scans, extracted content)
DATA_DIR=./data

# Not used yet (added in later tasks)
ANTHROPIC_API_KEY=replace-me
PARENT_PIN=0000